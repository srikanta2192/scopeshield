# Server-side OpenAI credentials; never expose an API key with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=
# Supabase project settings. The secret key is server-only and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe Checkout. Create one-time prices for one and five analysis credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK=
APP_BASE_URL=http://localhost:3000

# Leave disabled until the Supabase migration and Stripe webhook are configured.
ANALYSIS_ENABLED=false
# Local-only OpenAI smoke testing: honored only by `next dev`, never in production.
LOCAL_ANALYSIS_ENABLED=false
